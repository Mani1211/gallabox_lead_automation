# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# ── Gallabox (Settings → Developer Tools) ────────────────────────────────────
GALLABOX_API_KEY=
GALLABOX_API_SECRET=
GALLABOX_ACCOUNT_ID=

# ── Appwrite target DB / collection ──────────────────────────────────────────
APPWRITE_DATABASE_ID=
GALLABOX_LEADS_COLLECTION_ID=

# Server API key with documents.write (needed for LOCAL runs; on the deployed
# function you can instead rely on the dynamic key Appwrite injects).
APPWRITE_API_KEY=

# Appwrite endpoint + project (injected automatically when deployed; needed
# locally). Use APPWRITE_ENDPOINT/APPWRITE_PROJECT_ID here — the local runner
# maps them to the names the function expects.
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
